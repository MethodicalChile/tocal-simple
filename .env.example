# Ruta base de despliegue ('/' en Cloudflare Pages o dominio propio; '/tocal-simple/' en GitHub Pages)
VITE_BASE=/

# URL pública del sitio corporativo (para SEO, Open Graph y enlaces compartibles)
VITE_SITE_URL=https://www.tocal.cl

# Idioma predeterminado del sitio ('es' o 'en')
VITE_DEFAULT_LANGUAGE=es

# Mostrar etiquetas y avisos de contenido provisional/demostrativo ('true' o 'false')
VITE_SHOW_PROVISIONAL_BADGES=false

# URL base pública del bucket de Supabase Storage donde se alojan los videos optimizados
VITE_SUPABASE_MEDIA_URL=https://chqllbhsgfawmdogbjoy.supabase.co/storage/v1/object/public/tocal-media

# Datos de contacto principales de TOCAL
VITE_CONTACT_EMAIL=constructora@tocal.cl
VITE_WHATSAPP_NUMBER=56963269747
# Opcional: formato visual del número. Si se deja vacío, se formatea automáticamente desde VITE_WHATSAPP_NUMBER (+56 9 6326 9747)
VITE_WHATSAPP_DISPLAY=

# Mensajes precargados de WhatsApp (opcionales: si se dejan vacíos se utilizan los mensajes corporativos por defecto)
VITE_WHATSAPP_MSG_ES="Hola, me gustaría obtener más información sobre los servicios de TOCAL."
VITE_WHATSAPP_MSG_EN="Hello, I would like to receive more information about TOCAL's services."

# Teléfono y direcciones corporativas oficiales
VITE_OFFICE_PHONE="02-22474085 / 073-2220473"
VITE_COMPANY_ADDRESS="Av. Del Parque 4680-A, Of. 206, Huechuraba – Santiago | Fundo La Granja Lote 10, Oficina B, Linares"
VITE_LINKEDIN_URL=

# Opcional: Endpoint HTTP POST para envío directo del formulario (ej. Cloudflare Worker / Formspree)
VITE_CONTACT_ENDPOINT=
